# Authenova settings - copy the lines you need into .env

# Media engine (images + videos)
HIVE_API_KEY=your_hive_api_key_here

# Claim engine: live web search (required) - https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Claim engine: query planning + reasoning (recommended) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: GROQ_MODEL=llama-3.3-70b-versatile

# Claim engine: professional fact-checker verdicts (optional, free)
# Google Cloud API key with the "Fact Check Tools API" enabled
FACTCHECK_API_KEY=your_google_api_key_here
